type NotificationPage {
    items: [Notification!]!
    total: Int!
}

type Query {
    signIn: Show
    # 2FA — completes a pending sign-in. The MFA-pending challenge token
    # (minted by signIn for enrolled accounts) rides the Bearer header;
    # code is a 6-digit TOTP code or a recovery code.
    verifyMfa(code: String!): Show
    verifyPasswordResetLink(passwordResetLink: String!): Show
    getShow: Show
    dashboardLiveStats(startDate: Long!, endDate: Long!, timezone: String = "America/Chicago"): DashboardLiveStats
    dashboardStats(startDate: Long!, endDate: Long!, timezone: String = "America/Chicago"): DashboardStats
    dashboardStatsByHour(startDate: Long!, endDate: Long!, timezone: String = "America/Chicago"): DashboardHourlyStats
    viewerSessions(startDate: Long!, endDate: Long!, timezone: String = "America/Chicago"): ViewerSessions
    requestConversion(startDate: Long!, endDate: Long!, timezone: String = "America/Chicago"): RequestConversion
    psaEffectiveness(timezone: String = "America/Chicago"): PsaEffectiveness
    wrappedSummary(token: String!, season: String!, year: Int!, timezone: String): WrappedSummary
    showsOnAMap: [ShowsOnAMap]
    getShowsAutoSuggest(showName: String!): [String]
    getShowByShowName(showName: String!): Show
    getNotifications: [Notification]
    listAdminNotifications(offset: Int, limit: Int): NotificationPage!
    impersonateShow(showSubdomain: String!): Show
}
